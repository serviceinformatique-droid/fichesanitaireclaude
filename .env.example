# Copier ce fichier en ".env" et adapter les valeurs avant le premier lancement.

# Mot de passe de la base PostgreSQL (utilisé par le conteneur db ET par l'app).
DB_PASSWORD=ChangezMoi_MotDePasseSolide

# Port exposé sur l'hôte (LXC) pour accéder à l'application.
# C'est ce port qu'il faut renseigner comme "Forward Port" dans Nginx Proxy Manager.
APP_PORT=8099

# --- Envoi d'e-mails de relance (fiches sanitaires incomplètes) ---
# Renseignez les identifiants de votre serveur SMTP habituel (ex. celui utilisé
# pour SnappyMail / ndm94@wanadoo.fr, ou tout autre relais SMTP autorisé).
# Laissez SMTP_HOST vide pour désactiver la fonctionnalité de relance par mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fichesanitaire@ndmissions.fr

# --- Relances automatiques hebdomadaires (fiches incomplètes) ---
# URL publique du portail (celle utilisée par les familles), utilisée pour
# construire les liens directs dans les e-mails envoyés automatiquement.
PORTAL_URL=https://fichesanitaire.ndmissions.fr
# Planification (syntaxe cron). Par défaut : chaque lundi à 8h.
CRON_SCHEDULE=0 8 * * 1
CRON_TIMEZONE=Europe/Paris

# Nombre de jours de rétention des fiches supprimées dans la corbeille
# avant suppression définitive automatique.
TRASH_RETENTION_DAYS=30
